# ─── Database ──────────────────────────────────────────────────────────────────
# Local (Docker): postgres://postgres:postgres@localhost:5432/stockifyy
# Production (Neon / Supabase / Railway): use the connection string from your provider
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-64-byte-random-hex-string

# Name of the HTTP-only session cookie (can be anything, keep it short)
SESSION_COOKIE_NAME=sid

# ─── AI Chatbot ────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Only set on the SERVER — never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key-here

# ─── App ───────────────────────────────────────────────────────────────────────
# Set to "production" on your hosting platform; dev is handled by `next dev`
NODE_ENV=development

# Public base URL — no trailing slash.  Used for absolute URL generation.
# Local:      http://localhost:3001
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Technical Chart ───────────────────────────────────────────────────────────
# International market data for the Technical Chart (international symbols).
# PSX data is served from the database — no key needed for Pakistani symbols.
# Get a free key at: https://twelvedata.com/  (free tier: 8 req/min, 800/day)
# Leave blank to use built-in AAPL demo data (chart still works, clearly marked DEMO).
# SERVER-ONLY — never prefix with NEXT_PUBLIC_ — key must not reach the browser.
TWELVE_DATA_API_KEY=
